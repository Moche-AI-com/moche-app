# ============================================================
# Moche.AI — Environment Variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# ============================================================

# --- App ---
APP_URL=http://localhost:3000                      # Public base URL of the app (used for QR codes, redirects, Stripe return URLs)

# --- Supabase (LIVE project: moche-ai-app / sqpdzhannyskdiyuarhp) ---
NEXT_PUBLIC_SUPABASE_URL=https://sqpdzhannyskdiyuarhp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_-HkPT8taMPXw8B9oPfmj7Q_JvrqYfj4   # Safe for browser (publishable)
SUPABASE_SERVICE_ROLE_KEY=                         # SERVER ONLY. Bypasses RLS. Never expose to browser. Required for guest flows + admin.

# --- Guest verification ---
GUEST_CONTACT_SALT=change-me-to-a-long-random-string   # Salt for hashing guest phone/email. Rotating invalidates existing hashes.
GUEST_VERIFY_DEV_FALLBACK=true                     # DEV ONLY: returns/logs OTP instead of sending. MUST be false in production.

# --- Cloudflare Turnstile (guest bot protection) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=                    # Public site key. If unset, Turnstile widget is skipped (dev).
TURNSTILE_SECRET_KEY=                              # Server secret for verification. If unset, verification is skipped (dev only).

# --- AI provider (embeddings + generation) ---
AI_DEV_FALLBACK=true                               # DEV ONLY: deterministic hashed embeddings + templated answers. MUST be false in production.
AI_API_KEY=                                        # OpenAI-compatible API key
AI_BASE_URL=https://api.openai.com/v1              # OpenAI-compatible base URL
AI_EMBED_MODEL=text-embedding-3-small              # Must produce 1536-dim vectors
AI_CHAT_MODEL=gpt-4o-mini
AI_DEV_PROVIDER=                                   # DEV ONLY: set to 'ollama' to route getAIProvider() to a local Ollama instance. Ignored in production.
OLLAMA_BASE_URL=http://localhost:11434/v1          # Ollama's OpenAI-compatible endpoint
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text                # WARNING: default is 768-dim, not the locked 1536 EMBED_DIM. embed() will throw unless pointed at a 1536-dim model.

# --- OpenRouter model routing (OPTIONAL — server-side only) ---
# Leave OPENROUTER_API_KEY empty to keep today's behavior: routedCompletion() uses the
# OpenAI provider above. When set, eligible completions are routed to OpenRouter with PII
# redacted first; any failure falls back to the OpenAI provider.
OPENROUTER_API_KEY=                                 # OpenRouter API key. Never exposed to browser.
OPENROUTER_MODEL=openai/gpt-4o-mini                # Legacy/default slug; used as the default for any tier below that is unset.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Per-task model tiers (all default to sensible slugs; override only if needed).
OPENROUTER_MODEL_EXTRACTION=openai/gpt-4o-mini            # Structured extraction / normalization.
OPENROUTER_MODEL_CLASSIFICATION=meta-llama/llama-3.1-8b-instruct  # Cheap intent/label classification.
OPENROUTER_MODEL_CONCIERGE=anthropic/claude-haiku-4.5    # Guest-facing concierge (see toggle below).
OPENROUTER_MODEL_GENERAL=openai/gpt-4o-mini              # Everything else.
# Concierge (guest-facing) external routing is OFF by default even with a key set:
# guest answers stay on the in-house OpenAI provider unless this is explicitly enabled.
OPENROUTER_CONCIERGE_ENABLED=false

# --- Firecrawl (URL ingestion — server-side only) ---
INGESTION_DEV_FALLBACK=true                        # DEV ONLY: stub fetcher. MUST be false in production.
FIRECRAWL_API_KEY=                                 # Firecrawl API key. Never exposed to browser.
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# --- Resend (email delivery) ---
RESEND_API_KEY=                             # SERVER ONLY. Get from resend.com/api-keys. Sending access, moche-ai.com domain.

# --- Twilio (SMS delivery — server-side only) ---
# SECURITY: These are SERVER-ONLY secrets. NEVER prefix with NEXT_PUBLIC_.
# NEVER log, return to client, or embed in client bundles.
# Dual-auth resolution order:
#   1. TWILIO_API_KEY_SID + TWILIO_API_KEY_SECRET  (preferred — revocable API key)
#   2. TWILIO_AUTH_TOKEN                            (fallback — account auth token)
#   3. neither set → SMS disabled (server logs a warning; no throw)
# Account SID is always required; From number = TWILIO_FROM_NUMBER else TWILIO_PHONE_NUMBER.
TWILIO_ACCOUNT_SID=                                # ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx (always required)
TWILIO_API_KEY_SID=                                # SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx (preferred auth)
TWILIO_API_KEY_SECRET=                             # API key secret. Treat like a password.
# Legacy aliases (accepted): TWILIO_API_KEY → TWILIO_API_KEY_SID, TWILIO_API_SECRET → TWILIO_API_KEY_SECRET
TWILIO_AUTH_TOKEN=                                 # 32-char hex secret (fallback auth). Treat like a password.
TWILIO_FROM_NUMBER=                                # E.164: +1XXXXXXXXXX. Falls back to TWILIO_PHONE_NUMBER if unset.
# TWILIO_PHONE_NUMBER=                             # Legacy alias for the From number.

# --- Host SMS fan-out ---
NOTIFY_SMS_ENABLED=false                           # Master switch for host escalation/maintenance SMS. Keep false until phone consent
                                                   # columns (profiles.phone_verified_at, profiles.sms_opt_in) exist (compliance).

# --- Sentry (error monitoring) ---
NEXT_PUBLIC_SENTRY_DSN=                            # Public DSN (safe for browser). If unset, Sentry no-ops.
SENTRY_DSN=                                        # Server DSN (defaults to NEXT_PUBLIC_SENTRY_DSN if unset).
SENTRY_AUTH_TOKEN=                                 # SERVER ONLY. Enables source-map upload at build. Upload skipped if unset.
# SENTRY_ORG=                                      # Optional org slug for source-map upload.
# SENTRY_PROJECT=                                  # Optional project slug for source-map upload.

# --- PostHog (product analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=                           # Public project API key (safe for browser). If unset, analytics no-op.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com  # PostHog ingestion host.
POSTHOG_KEY=                                       # Optional server-side capture key. If unset, server capture no-ops.
# POSTHOG_HOST=                                    # Optional server host (defaults to NEXT_PUBLIC_POSTHOG_HOST).

# --- Stripe ---
STRIPE_SECRET_KEY=                                 # Server-only secret key (sk_...)
STRIPE_WEBHOOK_SECRET=                             # Webhook signing secret (whsec_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=                # Publishable key (pk_...)
# One recurring price per tier per interval. Names match the PlanId values in
# lib/constants.ts. Pricing is PER PROPERTY (pitch-deck model, Aug 2026): the
# checkout route sets the Stripe line-item quantity to the account's active
# property count, so each price's unit amount is the per-property rate.
STRIPE_PRICE_STARTER_MONTHLY=                      # Essentials, $29/property/mo, 1-9 properties
STRIPE_PRICE_STARTER_ANNUAL=                       # Essentials, $290/property/yr
STRIPE_PRICE_PRO_MONTHLY=                          # Pro, $49/property/mo, 1-9 properties
STRIPE_PRICE_PRO_ANNUAL=                           # Pro, $490/property/yr
# Sales-assisted tiers. Leave blank until a contract price exists; checkout rejects
# these tiers regardless, so a blank value cannot break the self-serve flow.
STRIPE_PRICE_PORTFOLIO_MONTHLY=                    # Portfolio, 10-40 properties, $25-39/property/mo by contract
STRIPE_PRICE_PORTFOLIO_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=                   # Enterprise, 41+ properties, custom
STRIPE_PRICE_ENTERPRISE_ANNUAL=
# Retired with the flat tiers (Growth $119, Scale $169, Custom): their env vars
# (STRIPE_PRICE_GROWTH_LOWER_*, STRIPE_PRICE_GROWTH_UPPER_*, STRIPE_PRICE_CUSTOM_*)
# are no longer read by code and can be deleted from the environment.

# --- Trigger.dev (PR #4: background job orchestration) ---
TRIGGER_SECRET_KEY=                                # Server-only. Use the dev key (tr_dev_...) locally, prod key (tr_prod_...) in production. Selects environment automatically.

# --- AWS S3 (PR #3: private object storage, presigned direct-to-S3 PUT/GET) ---
AWS_REGION=us-east-2                               # Bucket region. Defaults to us-east-2 if unset.
S3_BUCKET=                                         # Private bucket name (block-all-public-access, SSE-S3, versioned, TLS-only policy).
AWS_ACCESS_KEY_ID=                                 # Server-only. Least-privilege IAM user scoped to this bucket only.
AWS_SECRET_ACCESS_KEY=                             # Server-only. Never prefix with NEXT_PUBLIC_.
