# ============================================================
# Moche.AI — Environment Variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# ============================================================

# --- App ---
APP_URL=http://localhost:3000                      # Public base URL of the app (used for QR codes, redirects, Stripe return URLs)

# --- Supabase (LIVE project: moche-ai-app / sqpdzhannyskdiyuarhp) ---
NEXT_PUBLIC_SUPABASE_URL=https://sqpdzhannyskdiyuarhp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_-HkPT8taMPXw8B9oPfmj7Q_JvrqYfj4   # Safe for browser (publishable)
SUPABASE_SERVICE_ROLE_KEY=                         # SERVER ONLY. Bypasses RLS. Never expose to browser. Required for guest flows + admin.

# --- Guest verification ---
GUEST_CONTACT_SALT=change-me-to-a-long-random-string   # Salt for hashing guest phone/email. Rotating invalidates existing hashes.
GUEST_VERIFY_DEV_FALLBACK=true                     # DEV ONLY: returns/logs OTP instead of sending. MUST be false in production.

# --- Cloudflare Turnstile (guest bot protection) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=                    # Public site key. If unset, Turnstile widget is skipped (dev).
TURNSTILE_SECRET_KEY=                              # Server secret for verification. If unset, verification is skipped (dev only).

# --- AI provider (embeddings + generation) ---
AI_DEV_FALLBACK=true                               # DEV ONLY: deterministic hashed embeddings + templated answers. MUST be false in production.
AI_API_KEY=                                        # OpenAI-compatible API key
AI_BASE_URL=https://api.openai.com/v1              # OpenAI-compatible base URL
AI_EMBED_MODEL=text-embedding-3-small              # Must produce 1536-dim vectors
AI_CHAT_MODEL=gpt-4o-mini

# --- Firecrawl (URL ingestion — server-side only) ---
INGESTION_DEV_FALLBACK=true                        # DEV ONLY: stub fetcher. MUST be false in production.
FIRECRAWL_API_KEY=                                 # Firecrawl API key. Never exposed to browser.
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# --- Resend (email delivery) ---
RESEND_API_KEY=                             # SERVER ONLY. Get from resend.com/api-keys. Sending access, moche-ai.com domain.

# --- Twilio (SMS delivery — server-side only) ---
# SECURITY: These are SERVER-ONLY secrets. NEVER prefix with NEXT_PUBLIC_.
# NEVER log, return to client, or embed in client bundles.
# Obtain from: console.twilio.com → Account Info (Account SID + Auth Token)
#              Phone Numbers → Manage → Active Numbers (From number)
TWILIO_ACCOUNT_SID=                                # ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=                                 # 32-char hex secret. Treat like a password.
TWILIO_FROM_NUMBER=                                # E.164 format: +1XXXXXXXXXX (your Twilio trial/purchased number)

# --- Stripe ---
STRIPE_SECRET_KEY=                                 # Server-only secret key (sk_...)
STRIPE_WEBHOOK_SECRET=                             # Webhook signing secret (whsec_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=                # Publishable key (pk_...)
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_PORTFOLIO_MONTHLY=
STRIPE_PRICE_PORTFOLIO_ANNUAL=
